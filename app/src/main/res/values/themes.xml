<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 Dark Theme - Grevling -->
    <style name="Theme.Grevling" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color - Green accent -->
        <item name="colorPrimary">#4CAF50</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#1F4A4A</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">#4CAF50</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#1F4A4A</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        
        <!-- Background and surface - Dark teal -->
        <item name="android:colorBackground">#0D1F1F</item>
        <item name="colorSurface">#152B2B</item>
        <item name="colorSurfaceVariant">#1F4A4A</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">#B0FFFFFF</item>
        
        <!-- Status bar - Dark -->
        <item name="android:statusBarColor">#0D1F1F</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation bar - Dark -->
        <item name="android:navigationBarColor">#152B2B</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Text input styling -->
        <item name="boxStrokeColor">#4CAF50</item>
        <item name="hintTextColor">#80FFFFFF</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.Grevling.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Outlined Card Style -->
    <style name="Widget.Grevling.CardView.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">16dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/md_outline</item>
    </style>
</resources>
