    <!-- Permissions -->
    <string name="permissions_header">Tillatelser</string>
    <string name="notification_access_button">Gi varseltilgang</string>
    <string name="request_permissions_button">Be om SMS/Anrop-tillatelser</string>
    <string name="battery_rationale_title">⚠️ Viktig for pålitelighet</string>
    <string name="battery_rationale_message">For at GrevlingAppen skal kunne videresende varsler pålitelig når telefonen sover (Doze Mode), må den unntas fra batterioptimalisering.\n\nDette bruker minimalt med strøm, men sikrer at appen ikke blir stoppet av Android midt på natten.</string>
    <string name="battery_rationale_confirm">Åpne innstillinger</string>
    <string name="battery_optimization_button">⚠️ Aktiver bakgrunnskjøring (Anbefalt)</string>
    <string name="notification_settings_toast">Aktiver Grevling i listen</string>
    <string name="permissions_denied_toast">Én eller flere tillatelser ble nektet</string>
    <string name="permissions_granted_toast">Alle tillatelser innvilget</string>
    <string name="permissions_already_granted">Alle tillatelser allerede innvilget</string>
    <string name="permission_rationale_title">Trenger tillatelser</string>
    <string name="permission_rationale_message">For at GrevlingAppen skal fungere, trenger den tilgang til:\n\n• SMS: For å kunne lese og videresende innkommende meldinger, og for å sende auto-svar.\n• Anrop: For å kunne varsle om tapte anrop.\n• Kontakter: For å kunne vise navn i stedet for bare telefonnummer.\n\nInformasjonen sendes kun til din konfigurerte email-adresse og blir ikke brukt til noe annet.</string>
    <string name="permission_rationale_confirm">Fortsett</string>
    <string name="permission_rationale_cancel">Avbryt</string>
    <string name="notification_rationale_title">Trenger varseltilgang</string>
    <string name="notification_rationale_message">For at GrevlingAppen skal kunne videresende varsler fra apper som Messenger, WhatsApp eller Snapchat, må den ha tilgang til å lese system-varsler.\n\nNår du trykker fortsett blir du sendt til system-innstillingene. Der må du finne \"Grevling\" i listen og skru på bryteren.</string>
    <string name="notification_rationale_confirm">Åpne innstillinger</string>
    <string name="permissions_status_notification_ok">✓ Varseltilgang: OK</string>
    <string name="permissions_status_notification_missing">✗ Varseltilgang: Mangler</string>
    <string name="permissions_status_sms_ok">✓ SMS/Anrop tillatelser: OK</string>
    <string name="permissions_status_sms_missing">✗ SMS/Anrop tillatelser: Mangler</string>
    <string name="permissions_status_battery_ok">✓ Bakgrunnskjøring: OK</string>
    <string name="permissions_status_battery_missing">✗ Bakgrunnskjøring: Begrenset (Anbefales aktivert)</string>
    <string name="permissions_status_sms">SMS/Anrop tillatelser: %d/3</string>
    <string name="restricted_settings_button">Tillatelser avvist?</string>
    <string name="restricted_settings_help_link">❓ Tillatelser avvist automatisk?</string>
    <string name="restricted_settings_title">Begrensede innstillinger (Android 13+)</string>
    <string name="restricted_settings_guide">Hvis tillatelser blir avvist automatisk, eller du ikke får skrudd på varseltilgang, må du aktivere \"Tillat begrensede innstillinger\":\n\n1. Åpne Innstillinger\n2. Gå til Apper → Grevling\n3. Trykk på tre prikker (⋮) øverst\n4. Velg \"Tillat begrensede innstillinger\"\n5. Bekreft med enhetens PIN/mønster\n6. Gå tilbake til denne appen og prøv igjen.\n\nDette er en Android-sikkerhetsmekanisme for apper som ikke er installert fra Google Play Store.</string>
    <string name="open_app_settings">Åpne app-innstillinger</string>

