<?xml version="1.0" encoding="utf-8"?>
<!-- Moderne widget bakgrunn med glassmorfisme-effekt og dybde -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Hovedgradient - mørk teal for å matche appen -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#1A3A3A"
                android:centerColor="#152B2B"
                android:endColor="#0D1F1F" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    
    <!-- Subtil overlay gradient for dybde (lysere øverst) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#00FFFFFF"
                android:endColor="#10FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    
    <!-- Glass-effekt highlight på toppen -->
    <item
        android:top="0dp"
        android:bottom="30dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#00FFFFFF"
                android:endColor="#15FFFFFF" />
            <corners 
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
    
    <!-- Indre skygge-effekt (mørkere kant nederst) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#00000000"
                android:endColor="#10000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    
    <!-- Subtil border for glass-effekt -->
    <item>
        <shape android:shape="rectangle">
            <stroke 
                android:width="1dp" 
                android:color="#30FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>

</layer-list>
