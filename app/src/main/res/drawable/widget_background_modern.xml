<?xml version="1.0" encoding="utf-8"?>
<!-- Moderne widget bakgrunn med gradient -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hovedgradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#004D4D"
                android:centerColor="#006A6A"
                android:endColor="#008080" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Subtil overlay for dybde -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#00FFFFFF"
                android:endColor="#20FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Glass-effekt highlight -->
    <item
        android:top="0dp"
        android:bottom="50dp"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#00FFFFFF"
                android:endColor="#15FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Subtil border -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#30FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
