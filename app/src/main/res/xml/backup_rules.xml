<?xml version="1.0" encoding="utf-8"?>
<!--
Backup rules for Android 11 and older (API < 31).
Blokkerer all automatisk backup av app-data for å beskytte krypterte credentials.
Dette samsvarer med data_extraction_rules.xml for nyere enheter.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
