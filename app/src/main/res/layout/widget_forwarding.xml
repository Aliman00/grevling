<?xml version="1.0" encoding="utf-8"?>
<!-- Widget layout 3x1 - med logo, statistikk og status -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/widget_background_modern">

    <!-- Grevling ikon -->
    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/app_name" />

    <!-- Info kolonne (Klikk her åpner appen) -->
    <LinearLayout
        android:id="@+id/widget_info_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_forwarded_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 forwarded today"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_last_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last: Never"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Status badge (Klikk her toggler videresending) -->
    <LinearLayout
        android:id="@+id/widget_status_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/widget_status_dot_active" />

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/widget_status_active"
            android:textColor="@color/widget_active"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>